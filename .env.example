# ---- Mazi Patrika configuration ----
# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-64-char-random-string-in-production

# Database. Option B (default): the SQLite driver built into Node 22 — no server,
# no ORM, no Docker. Option A: managed PostgreSQL 15+ created from
# infrastructure/postgres/001_init.sql (schema v7 + row-level security).
DATABASE_DRIVER=sqlite
DATABASE_PATH=./data/mazi.db
# DATABASE_URL=postgres://mazi:secret@cluster.example:5432/mazipatrika

# Payments (adapter: simulated | razorpay). simulated captures locally with no
# keys and no network, keeping the demo flow byte-identical; razorpay creates a
# real gateway order (receipt = booking id) through a lazily loaded optional SDK.
PAYMENT_ADAPTER=simulated
# Gateway credentials for live orders. Empty in simulated mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Signs the raw webhook body (HMAC-SHA256, x-razorpay-signature header).
# Missing or wrong signature answers 400; replays answer 200. Set any random
# string to accept simulated webhooks locally.
RAZORPAY_WEBHOOK_SECRET=
# Amount rule — the gateway is never the ledger. Print orders are prepaid in
# full: the payment row records kind=advance for the whole totalPaise while the
# ledger posts the full customerTotal waterfall (cash, gateway fee, vendor
# payable, GST, commission). Vendor bookings instead capture a 20% advance in
# the payment row while the same full-total posting is written to the ledger.

# AI. `deterministic` is the default and needs no key: the Marathi intent parser
# answers on its own, and the product never breaks because a provider is down.
AI_PROVIDER=deterministic
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Hard ceiling. When the month's spend reaches it, the assistant refuses rather
# than quietly overspending — the same rule as a family budget.
ASSISTANT_MONTHLY_USD_CAP=25

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
